<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged by Tauri into the macOS bundle. CAP-17a (#22): macOS shows the mic prompt with this
     text at the first capture, after a user action. Without the key the OS stops the app. -->
<plist version="1.0">
<dict>
  <key>NSMicrophoneUsageDescription</key>
  <string>Bottle uses the microphone only while you hold the talk key, use hands-free capture or record a meeting.</string>
</dict>
</plist>
