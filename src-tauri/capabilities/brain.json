{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "brain",
  "description": "Hidden brain window (ARC-2): every brain command; events: listen and emit_to only.",
  "windows": ["brain"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:event:allow-emit-to",
    "allow-cli-status",
    "allow-cli-install",
    "allow-profiles-list",
    "allow-profile-status",
    "allow-profile-login",
    "allow-profile-select",
    "allow-capture-start",
    "allow-capture-stop",
    "allow-capture-pause",
    "allow-capture-status",
    "allow-capture-stop-all",
    "allow-capture-subscribe",
    "allow-session-attest",
    "allow-stt-transcribe",
    "allow-insert-text",
    "allow-agent-start",
    "allow-agent-stop",
    "allow-agent-send",
    "allow-agent-tool-result",
    "allow-model-invoke",
    "allow-mcp-call",
    "allow-dbx-http",
    "allow-mem-local-exec",
    "allow-mem-remote-exec",
    "allow-mem-remote-status",
    "allow-config-list",
    "allow-config-read",
    "allow-config-write",
    "allow-config-delete",
    "allow-policy-get",
    "allow-hotkeys-set",
    "allow-mog-set-active",
    "allow-window-mog-open",
    "allow-window-mog-close",
    "allow-window-card-show",
    "allow-window-card-hide",
    "allow-audit-append",
    "allow-telemetry-span",
    "allow-brain-subscribe"
  ]
}
