    "allow-profile-login-cancel",
    "allow-profile-select",
    "allow-capture-start",
    "allow-capture-stop",
    "allow-capture-pause",
    "allow-capture-resume",
    "allow-capture-status",
    "allow-capture-stop-all",
    "allow-capture-subscribe",
    "allow-session-attest",
    "allow-consent-notice-record",
    "allow-consent-records-list",
    "allow-stt-transcribe",
