{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "hub",
  "description": "Hub view window (V1): listens to brain-to-view events; calls the brain-and-hub commands of 4.5, permission_request and permission_status (ADR 0039, ADR 0101), view_emit and view_notice_subscribe (the hub-only notice Channel, ADR 0091), the recording_* rows (ADR 0103), and stt_model_* (the Local speech step, ADR 0104).",
  "windows": ["hub"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-cli-status",
    "allow-cli-install",
    "allow-profiles-list",
    "allow-profile-status",
    "allow-profile-login",
    "allow-profile-login-cancel",
    "allow-profile-select",
    "allow-mem-remote-status",
    "allow-config-list",
    "allow-config-read",
    "allow-config-write",
    "allow-config-delete",
    "allow-app-setting-read",
    "allow-app-setting-write",
    "allow-policy-get",
    "allow-hotkeys-set",
    "allow-permission-request",
    "allow-permission-status",
    "allow-view-emit",
    "allow-view-notice-subscribe",
    "allow-recording-settings-read",
    "allow-recording-settings-write",
    "allow-recording-storage-probe",
    "allow-recording-volume-create",
    "allow-recording-start",
    "allow-recording-stop",
    "allow-recording-state",
    "allow-recording-list",
    "allow-recording-detail",
    "allow-recording-retry",
    "allow-recording-open",
    "allow-recording-open-system-audio-settings",
    "allow-stt-model-status",
    "allow-stt-model-consent",
    "allow-stt-model-install",
    "allow-stt-model-verify",
    "allow-stt-model-cancel"
  ]
}
