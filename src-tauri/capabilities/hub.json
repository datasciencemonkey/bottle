{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "hub",
  "description": "Hub view window (V1): listens to brain-to-view events; calls the brain-and-hub commands of 4.5 and view_emit.",
  "windows": ["hub"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-cli-status",
    "allow-cli-install",
    "allow-profiles-list",
    "allow-profile-status",
    "allow-profile-login",
    "allow-profile-select",
    "allow-mem-remote-status",
    "allow-config-list",
    "allow-config-read",
    "allow-config-write",
    "allow-config-delete",
    "allow-policy-get",
    "allow-hotkeys-set",
    "allow-view-emit"
  ]
}
